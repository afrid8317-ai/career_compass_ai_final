# SQLite local default. For PostgreSQL use postgresql+psycopg://user:password@localhost:5432/careercompass
DATABASE_URL=sqlite:///./careercompass.db
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated production origins, e.g. https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional server-side model integration. Never place this key in frontend variables.
GEMINI_API_KEY=
# Optional free API key for higher Himalayas remote-jobs API limits; the public API works without a key.
HIMALAYAS_API_KEY=
# Comma-separated administrator emails; keep this empty unless you intentionally provision an admin.
ADMIN_EMAILS=
